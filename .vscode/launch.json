{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Frigate Event Processor",
            "type": "debugpy",
            "request": "launch",
            "module": "src.frigate_event_processor.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
        }
    ]
}